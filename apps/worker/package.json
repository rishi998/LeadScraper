    "@leadintel/discovery": "workspace:*",
    "@leadintel/entity-resolution": "workspace:*",
    "@leadintel/excel": "workspace:*",
    "@leadintel/intelligence": "workspace:*",
    "@leadintel/job-queue": "workspace:*",
    "@leadintel/providers": "workspace:*",
    "@leadintel/scoring": "workspace:*",
    "@leadintel/shared": "workspace:*",
    "@leadintel/technology": "workspace:*",
    "mongoose": "^8.9.3",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
