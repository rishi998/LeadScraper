# MongoDB Atlas (or any MongoDB URI)
# Never expose MONGODB_URI to the Next.js frontend.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/lead_intelligence?retryWrites=true&w=majority
# Optional override if URI has no db name:
# MONGODB_DB_NAME=lead_intelligence

# Optional dedicated URI for integration tests (never use production)
# MONGODB_TEST_URI=mongodb+srv://.../lead_intelligence_test

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Worker (MongoDB-backed job queue)
WORKER_ID=
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
WORKER_LOCK_TIMEOUT_MS=300000
WORKER_STALE_RECOVERY_INTERVAL_MS=60000
GLOBAL_CRAWL_CONCURRENCY=5
PER_DOMAIN_CONCURRENCY=1
DOMAIN_DELAY_MS=250
EXPORT_DIR=./exports

# Crawler
CRAWLER_USER_AGENT=LeadIntelBot/1.0 (+https://example.com/bot)
CRAWLER_MAX_PAGES=15
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_CONTENT_BYTES=2097152
CRAWLER_CONCURRENCY=3

# Browser / Playwright crawl fallback (when HTTP looks like a JS shell)
# Optional; maps:login auto-detects Google Chrome on Windows if unset
CHROME_EXECUTABLE_PATH=
ENABLE_PLAYWRIGHT=true
PLAYWRIGHT_SKIP=

# Performance lab metrics: mock | lighthouse | pagespeed
PERFORMANCE_PROVIDER=mock
PAGESPEED_API_KEY=

# Discovery: mock | google-places | playwright-maps | search-discovery | licensed-directory | csv-import
DISCOVERY_PROVIDER=mock
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_RESULTS=20

# Playwright Google Maps discovery (free — no API key; sign in once via pnpm maps:login)
# List Chrome profiles: pnpm maps:profiles
PLAYWRIGHT_MAPS_PROFILE_DIR=
PLAYWRIGHT_MAPS_HEADLESS=true
PLAYWRIGHT_MAPS_MAX_RESULTS=20

# Use an existing Chrome profile (close Chrome completely first)
CHROME_USE_EXISTING_PROFILE=false
# CHROME_USER_DATA_DIR=C:\Users\YOU\AppData\Local\Google\Chrome\User Data
# CHROME_PROFILE_DIRECTORY=Default

ENABLE_WAPPALYZER=false
ENABLE_AI_ANALYSIS=false
AI_PROVIDER=
OPENAI_API_KEY=

SCORING_ALGORITHM_VERSION=scoring@1.0.0
LOG_LEVEL=info
